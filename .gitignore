# Installed tools, scratch and build products (regenerated by scripts)
tools/
build/
deliverables/
_to_delete/
*.~backup
__pycache__/

# IEEE paper and text/images extracted from it: not redistributable
*.pdf
reports/paper_*
# Upstream tool documentation copied from the ORFS image
reports/orfs_readme.md
reports/openroad_release.json

# ORFS intermediates: keep only the final outputs
physical/objects/
# (applies to every flow variant: base, cg)
physical/results/sky130hd/ecg_snn_core/*/*
!physical/results/sky130hd/ecg_snn_core/*/6_final.*
!physical/results/sky130hd/ecg_snn_core/*/6_lvs.lvsdb
!physical/results/sky130hd/ecg_snn_core/*/ecg_snn_core_extracted.cir
!physical/results/sky130hd/ecg_snn_core/*/1_2_yosys.v
!physical/results/sky130hd/ecg_snn_core/*/1_synth.sdc

# Final-netlist activity traces can exceed GitHub's 50 MB warning; regenerate
# with scripts/activity_power_variant.sh (they are in the release ZIP).
reports/power_*/*.vcd
